# Public/local topology (never prefix secrets with VITE_)
PRAXIS_API_BASE_URL="http://127.0.0.1:8787"
PRAXIS_PUBLIC_API_BASE_URL="http://127.0.0.1:8787"
PRAXIS_RENDER_WORKER_URL="http://127.0.0.1:8790"
PRAXIS_OBJECT_STORE_ROOT="./.praxis-data/objects"

# Local owner/capability authentication
PRAXIS_OWNER_TOKEN="replace-with-a-long-random-owner-token"
PRAXIS_CAPABILITY_SIGNING_SECRET="replace-with-at-least-32-random-characters"
PRAXIS_RENDER_AUTH_SECRET="replace-with-at-least-32-random-characters"
PRAXIS_RENDER_RESULT_SIGNING_SECRET="replace-with-a-distinct-32-character-secret"
PRAXIS_RENDER_RESULT_SIGNING_KEY_ID="praxis-render-result-local-v1"
PRAXIS_RENDER_RESULT_VERIFY_KEYS_JSON="{}"
PRAXIS_BROWSER_SESSION_SIGNING_SECRET="replace-with-a-distinct-32-character-secret"
PRAXIS_AGENT_CLAIM_SIGNING_SECRET="replace-with-a-distinct-32-character-secret"
PRAXIS_DISPATCHER_TOKEN="replace-with-a-distinct-32-character-token"
PRAXIS_AGENT_LEASE_SECONDS="1800"
PRAXIS_RECONCILE_INTERVAL_SECONDS="30"
PRAXIS_CANCEL_GRACE_SECONDS="45"

# Provider configuration. Live calls remain opt-in.
OPENAI_API_KEY=""
PRAXIS_PROVIDER_MODE="fake"
PRAXIS_IMAGE_MODEL="gpt-image-2"
PRAXIS_TTS_MODEL="gpt-4o-mini-tts"
PRAXIS_TTS_VOICE="alloy"
PRAXIS_LIVE_MEDIA_TEST="0"

# Optional production R2 S3 direct-upload signing values
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="praxis-media"

# Staging Cloudflare Access browser boundary (not used in local owner mode)
PRAXIS_AUTH_MODE="development_owner"
PRAXIS_ACCESS_TEAM_DOMAIN=""
PRAXIS_ACCESS_AUD=""
PRAXIS_ALLOWED_ORIGIN="http://127.0.0.1:4173"
