{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vitest/globals", "node"],
    "paths": {
      "@praxis/agent-runs": ["./packages/agent-runs/src/index.ts"],
      "@praxis/project-schema": ["./packages/project-schema/src/index.ts"],
      "@praxis/commands": ["./packages/commands/src/index.ts"],
      "@praxis/history": ["./packages/history/src/index.ts"],
      "@praxis/webmcp": ["./packages/webmcp/src/index.ts"],
      "@praxis/markdown-projection": ["./packages/markdown-projection/src/index.ts"],
      "@praxis/qc": ["./packages/qc/src/index.ts"],
      "@praxis/jobs": ["./packages/jobs/src/index.ts"],
      "@praxis/media": ["./packages/media/src/index.ts"],
      "@praxis/render-manifest": ["./packages/render-manifest/src/index.ts"],
      "@praxis/remote-client": ["./packages/remote-client/src/index.ts"]
    }
  },
  "include": ["apps", "packages", "vite.config.ts"]
}
