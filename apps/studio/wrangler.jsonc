{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "praxis-studio",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "praxis-studio-staging",
      "workers_dev": false,
      "preview_urls": false,
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "invocation_logs": true
        }
      }
    }
  }
}
