# HMAC secret shared only with the trusted dispatcher. Never put this in the studio.
PRAXIS_RENDER_AUTH_SECRET=replace-with-at-least-32-random-characters
PRAXIS_RENDER_TOKEN_MAX_TTL_SECONDS=900
# Dedicated result attestation key shared only with the control plane.
PRAXIS_RENDER_RESULT_SIGNING_SECRET=replace-with-a-distinct-32-character-secret
PRAXIS_RENDER_RESULT_SIGNING_KEY_ID=praxis-render-result-v1

# Optional local/admin escape hatch. Production job dispatch should leave this off.
PRAXIS_RENDER_ALLOW_STATIC_AUTH=0
# PRAXIS_RENDER_AUTH_TOKEN=replace-with-at-least-32-random-characters

PRAXIS_RENDER_PORT=8790
PRAXIS_OBJECT_STORE_ROOT=/tmp/praxis-object-store
PRAXIS_RENDER_TEMP_ROOT=/tmp/praxis-render-jobs
PRAXIS_RENDER_TIMEOUT_MS=180000
PRAXIS_RENDER_MAX_REQUEST_BYTES=2097152
PRAXIS_RENDER_MAX_ASSET_BYTES=104857600
PRAXIS_RENDER_MAX_TOTAL_ASSET_BYTES=524288000
PRAXIS_RENDER_MAX_OUTPUT_BYTES=1073741824
PRAXIS_RENDERER_VERSION=praxis-ffmpeg-1

# Optional system-binary overrides. The packaged static binaries are preferred.
# PRAXIS_FFMPEG_PATH=/usr/bin/ffmpeg
# PRAXIS_FFPROBE_PATH=/usr/bin/ffprobe
# The renderer image pins this exact family/face for deterministic text.
PRAXIS_FONT_PATH=/usr/share/fonts/truetype/roboto/unhinted/RobotoCondensed-Bold.ttf
PRAXIS_FONT_FAMILY=Roboto Condensed Variable
# Internal family name exposed by the bundled static TTF to libass.
PRAXIS_ASS_FONT_FAMILY=Roboto Condensed
PRAXIS_FONT_WEIGHT=700
PRAXIS_FONT_STYLE=normal
